{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"types": ["jest"],
		"strict": true,
		"paths": {
			"@domain/*": ["./src/domain/*"],
			"@data/*": ["./src/data/*"],
			"@application/*": ["./src/application/*"],
			"@presentation/*": ["./src/presentation/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["**/node_modules", "**/Pods"]
}
